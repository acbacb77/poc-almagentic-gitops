  {
   "id": 7,
   "title": "Peticiones: en qué fase está cada una",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 9
   },
   "description": "Las 30 peticiones más recientes de app. «Te toca» indica la acción humana pendiente, si la hay.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "alm_peticion_fase_segundos",
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Tiempo"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "url"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Abrir",
          "url": "${__value.text}"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Tiempo",
      "desc": true
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "app_kubernetes_io_name": true,
       "pod_template_hash": true,
       "namespace": true,
       "pod": true,
       "kubernetes_namespace": true,
       "kubernetes_pod_name": true
      },
      "renameByName": {
       "numero": "Issue",
       "titulo": "Título",
       "fase": "Fase",
       "accion": "Te toca",
       "Value": "Tiempo"
      },
      "indexByName": {
       "numero": 0,
       "titulo": 1,
       "fase": 2,
       "accion": 3,
       "Value": 4
      }
     }
    }
   ]
  },
