{
 "uid": "agentes",
 "title": "Actividad de los agentes",
 "description": "Ejecuciones de triage, revisor, respuesta a @claude y agente autónomo, leídas de la API de GitHub por el exportador.",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "poc-almagentic"
 ],
 "panels": [
  {
   "id": 1,
   "title": "Ejecuciones por agente y resultado",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "agentes_ejecuciones",
     "legendFormat": "{{agente}} · {{resultado}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
